        </mxCell>

        <!-- ============ 底部实测表 ============ -->
        <mxCell id="table_title" value="实测验证（exp_segment_del_robust.py）—— 抗删能力 ∝ √N（UID=0x5555 高熵，65535 候选盲检 soft_match）" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="20" y="510" width="1240" height="25" as="geometry" />
